# Configuración de un proceso P08 iniciado manualmente (el lanzador local no requiere este archivo).
SOUNDFLOW_SERVICE=gateway
SOUNDFLOW_CLUSTER_TOKEN=cambia-este-valor-por-uno-generado-localmente
SOUNDFLOW_BASE_URL=http://127.0.0.1:8000
SOUNDFLOW_CATALOG_URL=http://127.0.0.1:8001
SOUNDFLOW_PLAYBACK_URL=http://127.0.0.1:8002
SOUNDFLOW_MEDIA_NODES={"S1":"http://127.0.0.1:5000","S2":"http://127.0.0.1:5001"}
SOUNDFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOUNDFLOW_RPC_TIMEOUT=10
SOUNDFLOW_WAIT_TIMEOUT=120
SOUNDFLOW_TICKETS_DB=.state/playback.sqlite3
# Solo para un proceso de medios:
# SOUNDFLOW_NODE_ID=S1
# SOUNDFLOW_MUSIC_DIR=.local_music/S1
